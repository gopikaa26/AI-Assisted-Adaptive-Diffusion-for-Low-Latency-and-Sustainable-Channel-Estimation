    'LS': 'LS', 'LS-DFT': 'LS-DFT', 'LMMSE': 'LMMSE', 'CNN': 'CNN (Proposed)'
}


def make_fig(results, snr, title_a, title_b, suptitle, fname):
    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))
    fig.suptitle(suptitle, fontsize=13, fontweight='bold', y=1.01)

    for m in ['LS', 'LS-DFT', 'LMMSE', 'CNN']:
        kw = STYLE[m]
        axes[0].semilogy(snr, results[m]['nmse'], label=METHOD_LABEL[m], **kw)
        axes[1].semilogy(snr, results[m]['ber'],  label=METHOD_LABEL[m], **kw)

    for ax, ylabel, title in [
        (axes[0], 'NMSE',        title_a),
        (axes[1], 'Bit Error Rate (BER)', title_b),
    ]:
        ax.set_xlabel('SNR (dB)')
        ax.set_ylabel(ylabel)
        ax.set_title(title, fontweight='bold')
        ax.set_xticks(snr)
        ax.legend(loc='upper right')
        ax.yaxis.set_major_formatter(ticker.LogFormatterMathtext())
        ax.set_xlim(snr[0]-1, snr[-1]+1)

    # BER axis: show reference lines
    axes[1].axhline(y=0.5,  color='gray', linewidth=0.8, linestyle=':', alpha=0.5)
    axes[1].axhline(y=0.01, color='gray', linewidth=0.8, linestyle=':', alpha=0.5)
    axes[1].set_ylim(1e-4, 1.0)

    fig.tight_layout()
    fig.savefig(fname, dpi=150, bbox_inches='tight')
    plt.close(fig)
    print(f"  Saved: {fname}")


